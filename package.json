{
  "name": "character-mind-v3",
  "version": "3.0.0-ts",
  "private": true,
  "description": "Character Mind — evidence-linked memory and integrated affective dynamics.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/dev-entry.ts",
    "start": "tsx src/dev-entry.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/eval/run-eval.ts",
    "eval:safety": "tsx src/eval/run-eval.ts --suite safety",
    "eval:personality": "tsx src/eval/run-eval.ts --suite personality",
    "test:cognition": "node --experimental-transform-types --import ./tests/resolve-typescript.mjs --test tests/cognition.test.ts tests/cognitive-integration.test.ts tests/dynamics.test.ts",
    "typecheck": "tsc --noEmit",
    "test:tui": "vitest run src/ui/workspace.test.tsx",
    "test:live": "tsx tests/live-smoke.ts",
    "test:live-affect": "tsx tests/live-affect.ts"
  },
  "dependencies": {
    "fast-glob": "3.3.3",
    "ink": "7.0.6",
    "marked": "18.0.5",
    "openai": "6.42.0",
    "react": "19.2.7",
    "string-width": "8.2.1",
    "strip-ansi": "7.2.0",
    "tsx": "4.22.4",
    "yaml": "2.9.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
